# SysDrill 환경변수 예시
#
# 모든 값은 선택 사항입니다 — 기본값만으로 로컬에서 전체 흐름이 동작합니다.
# (LLM 키가 비어 있으면 스텁 평가, Google OAuth가 비어 있으면 이메일 로그인만)
#
# 사용법:
#   cp .env.example backend/.env.local
#   ./scripts/run.sh
#
# backend/.env.local 은 Gradle bootRun 이 시작할 때 환경변수로 읽어들입니다
# (backend/build.gradle.kts 참고 — 테스트(`gradlew test`)에는 적용되지 않습니다).
# 셸에서 직접 export 해도 동일하게 동작합니다.
# 프론트엔드(Next.js)는 frontend/.env.local 을 자동으로 읽습니다.
# DB/Redis/Kafka/Jaeger 포트는 scripts/run.sh 가 자동으로 잡아 넘기므로
# 여기서 설정할 필요가 없습니다 (docker compose 를 직접 쓸 때만 아래 참고).

# ── AI 평가 (Anthropic Claude) ──────────────────────────────────────────
# ANTHROPIC_* 가 아니라 LLM_ANTHROPIC_* 인 이유: docs/adr/0005
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-sonnet-5
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_ANTHROPIC_MAX_TOKENS=16000
# 사용자당 일일 LLM 평가 상한 (남용 방지용)
# EVALUATION_DAILY_LIMIT_PER_USER=50

# ── 인증 ────────────────────────────────────────────────────────────────
# 실제 배포 시 반드시 교체. 로컬에서는 기본값(dev-only)으로 충분합니다.
SYSDRILL_AUTH_JWT_SECRET=
# SYSDRILL_AUTH_TOKEN_TTL_DAYS=30
# 쉼표 구분 — 가입 시 PLATFORM_ADMIN 권한을 받을 이메일 (관리자 화면 /admin 접근용)
SYSDRILL_AUTH_PLATFORM_ADMIN_EMAILS=

# Google 로그인 ("Google로 계속하기"). 비어 있으면 버튼이 동작하지 않습니다.
SYSDRILL_AUTH_GOOGLE_CLIENT_ID=
SYSDRILL_AUTH_GOOGLE_CLIENT_SECRET=
# SYSDRILL_AUTH_GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback

# ── 메일 (비밀번호 재설정 / 이메일 인증 / 조직 초대) ────────────────────
# spring.mail.host 가 비어 있으면 메일 발송이 비활성화되고 링크는 로그에 출력됩니다.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SYSDRILL_MAIL_FROM=no-reply@sysdrill.dev

# ── 프론트엔드 (frontend/.env.local 에 두어도 됩니다) ────────────────────
# run.sh 가 백엔드 실제 포트에 맞춰 자동 설정합니다. 수동 실행 시에만 지정.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# ── Build 과제 채점 샌드박스 (Docker) ───────────────────────────────────
# BUILD_SANDBOX_IMAGE=python:3.12-slim
# BUILD_TIMEOUT_SECONDS=10

# ── 인프라 포트 (docker compose 를 run.sh 없이 직접 띄울 때만) ──────────
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=sysdrill
# DB_USER=sysdrill
# DB_PASSWORD=sysdrill
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REALINFRA_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# REALINFRA_TOXIPROXY_ADMIN_URL=http://localhost:8474
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# ── Build 과제 제출 CLI (challenges/*/submit.sh) ────────────────────────
# SYSDRILL_API_BASE_URL=http://localhost:8081
# SYSDRILL_USER_ID=

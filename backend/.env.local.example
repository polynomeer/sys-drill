# Copy to backend/.env.local and fill in your key. Only read by `./gradlew
# bootRun` (see build.gradle.kts) — never required for `./gradlew test`,
# which runs against AnthropicLlmClient's offline fallback.
#
# Deliberately namespaced LLM_ANTHROPIC_* rather than ANTHROPIC_* so this
# never collides with Claude Code's own ANTHROPIC_* environment variables in
# this same shell.

LLM_ANTHROPIC_API_KEY=sk-ant-...
# LLM_ANTHROPIC_MODEL=claude-sonnet-5
# LLM_ANTHROPIC_MAX_TOKENS=2000
